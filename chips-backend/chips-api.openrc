#!/sbin/openrc-run

name="chips-api"
description="CHIPS FastAPI Backend"
command="/home/idori/chips-backend/.venv/bin/uvicorn"
command_args="app.main:app --host 0.0.0.0 --port 8000"
command_user="idori"
directory="/home/idori/chips-backend"
pidfile="/run/chips-api.pid"
command_background=true

depend() {
    need net postgresql redis
}
