# Private server file: copy to .env and chmod 600. Never commit actual credentials.
DATABASE_URL=postgresql+asyncpg://chips:CHANGE_ME@127.0.0.1:55432/chips
REDIS_URL=redis://127.0.0.1:6379/0
ALLOW_INSECURE_LOCAL=false
# Local multilingual Whisper (install requirements-local-stt.txt and download first).
STT_PROVIDER=local
STT_MODEL=/absolute/path/to/downloaded/whisper-small
# STT_LANGUAGE=en
# Independent API alternative: explicitly choose provider=api, full URL and model.
# STT_PROVIDER=api
# STT_URL=https://YOUR_PROVIDER/v1/audio/transcriptions
# STT_MODEL=YOUR_TRANSCRIPTION_MODEL
# STT_API_KEY=
# LLM: full OpenAI-compatible endpoint, local or explicitly selected API.
LLM_URL=http://127.0.0.1:11434/v1/chat/completions
LLM_MODEL=qwen3.5:9b
# LLM_API_KEY=
# For this local Qwen model. Leave unset for APIs without reasoning_effort support.
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=2400
# Independent vision selection for drawings and receipt drafts.
DRAWING_VISION_URL=http://127.0.0.1:11434/v1/chat/completions
DRAWING_VISION_MODEL=qwen3.5:9b
DRAWING_REASONING_EFFORT=none
# DRAWING_VISION_API_KEY=
