# Create .env ON THE SERVER as its service user; keep it readable only by that user.
# Supply actual database credentials locally; this file contains examples only.
DATABASE_URL=postgresql+asyncpg://chips:CHANGE_ME@127.0.0.1:5432/chips
REDIS_URL=redis://127.0.0.1:6379/0
ALLOW_INSECURE_LOCAL=false
# Activity sync requires no AI key. Optional voice-demo provider configuration:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Drawing vision is independent of voice. Explicitly select a vision-capable model.
# Local Ollama example (use an installed vision model; no cloud fallback):
# DRAWING_VISION_URL=http://127.0.0.1:11434/v1/chat/completions
# DRAWING_VISION_MODEL=your-installed-vision-model
# DRAWING_VISION_API_KEY=
